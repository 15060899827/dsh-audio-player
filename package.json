{
  "name": "dsh-audio-player",
  "version": "1.0.0",
  "type": "module",
  "main": "lib/index.js",
  "description": "Inline audio player for DeepSeek Harness: play generated voice clips, songs and sounds right inside the conversation.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "audio",
    "player"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "LICENSE",
    "README.md",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node test/verify.mjs && node test/client.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  }
}
